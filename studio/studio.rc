#include "resource.h"
#include <winver.h>
IDI_APP ICON "assets/hybridcore.ico"
IDR_SKIN RCDATA "assets/skin.jpg"
IDR_DESK RCDATA "assets/desk.jpg"
1 24 "studio.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Hybrid Elite Mafia"
      VALUE "FileDescription", "HYBRID CORE 2 ELITE"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "THE HYBRID CORE"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "HybridCore.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
