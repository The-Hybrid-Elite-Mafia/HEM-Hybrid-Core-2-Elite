#include "setup_resource.h"
#include <winver.h>
IDI_SETUP ICON "../studio/assets/hybridcore.ico"
IDR_PAYLOAD_APP RCDATA "../build-win/HybridCore2Elite.exe"
1 24 "setup.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Hybrid Elite Mafia"
      VALUE "FileDescription", "HYBRID CORE 2 ELITE Setup"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "HYBRID CORE 2 ELITE"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "HybridCore2Elite-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
